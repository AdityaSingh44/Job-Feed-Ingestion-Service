# Application Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Connection
# Set to your MongoDB connection string (e.g., from Docker Compose: mongodb://localhost:27017/jobfeed)
# If left empty, an embedded real MongoDB instance will automatically launch for local testing/dev.
MONGODB_URI=mongodb://127.0.0.1:27017/jobfeed
MONGODB_DB_NAME=jobfeed

# Worker Pool Configuration
WORKER_COUNT=2
POLL_INTERVAL_MS=100
LEASE_DURATION_MS=5000
BASE_BACKOFF_MS=300

# GEMINI_API_KEY: Injected by AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
